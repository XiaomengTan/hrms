    <select id="getSalaryById" resultType="com.hrms.domain.common.entity.Salary">
        SELECT s.*
        FROM salary s
        INNER JOIN worker w
        ON s.worker_id = w.id
        <if test="id != null and id != ''">
            AND s.id LIKE CONCAT('%', #{id}, '%')
        </if>
        <if test="name != null and name != ''">-->
            AND w.name LIKE CONCAT('%', #{name}, '%')
        </if>
        AND 1 = 1
    </select>
</mapper>